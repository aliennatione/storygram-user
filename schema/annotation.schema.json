{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storygram.local/schema/annotation.schema.json",
  "title": "Storygram Annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^annotation:[A-Za-z0-9][A-Za-z0-9._~-]*$"},
    "type": {"const": "Annotation"},
    "status": {"type": "string", "enum": ["draft", "proposed", "reported", "confirmed", "disputed", "rejected", "archived"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "target_ids": {"type": "array", "items": {"type": "string"}},
    "episode_ids": {"type": "array", "items": {"type": "string", "pattern": "^episode:[A-Za-z0-9][A-Za-z0-9._~-]*$"}},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^source:[A-Za-z0-9][A-Za-z0-9._~-]*$"}},
    "notes": {"type": "string"},
    "visibility": {"type": "string", "enum": ["private", "restricted", "family", "public"]}
  }
}
