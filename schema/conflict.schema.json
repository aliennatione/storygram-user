{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storygram.local/schema/conflict.schema.json",
  "title": "Storygram Conflict",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "assertions", "status", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^conflict:[A-Za-z0-9][A-Za-z0-9._~-]*$"},
    "type": {"const": "Conflict"},
    "assertions": {"type": "array", "items": {"type": "string", "pattern": "^assertion:[A-Za-z0-9][A-Za-z0-9._~-]*$"}, "minItems": 2, "uniqueItems": true},
    "relation": {"type": "string", "enum": ["contradicts", "inconsistent", "competing"]},
    "status": {"type": "string", "enum": ["open", "under_review", "resolved", "accepted_as_plural", "rejected"]},
    "reason": {"type": "string"},
    "identified_at": {"type": "string", "format": "date-time"},
    "review": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "reviewer": {"type": "string"},
    "decision": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "visibility": {"type": "string", "enum": ["private", "restricted", "family", "public"]},
    "notes": {"type": "string"}
  }
}
